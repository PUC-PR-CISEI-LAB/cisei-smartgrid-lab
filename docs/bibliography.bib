  journal = {Communications of the ACM},
  year    = {1972},
  volume  = {15},
  number  = {12},
  pages   = {1053--1058},
  month   = dec,
  doi     = {10.1145/361598.361623},
  note    = {Critério fundacional de decomposição modular: separar por ocultação de informação e por probabilidade de mudança conjunta, não por etapa de fluxograma. Sustenta o eixo R da ADR-034 — a fronteira entre repositórios segue o acoplamento medido, não a audiência declarada}
}

